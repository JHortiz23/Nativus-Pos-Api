generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  SENT_TO_KITCHEN
  IN_PROGRESS
  READY
  SERVED
  PAID
  CANCELED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      String // admin, cashier, waiter, kitchen
  createdAt DateTime @default(now())
  // orders    Order[]
}

model Table {
  id        Int      @id @default(autoincrement())
  name      String // "Mesa 1"
  isOpen    Boolean  @default(false)
  createdAt DateTime @default(now())
  // orders    Order[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  // items     OrderItem[]
}
